# ---------------------------------------------------------------------------
# Base de datos.
#   Vacio  -> PGlite embebido en ./data/pg: desarrollo local sin instalar nada.
#             Es lo que va en .env.local, SIEMPRE.
#   Supabase -> el "Connection string" del proyecto (Transaction pooler):
#   DATABASE_URL=postgres://postgres.xxxx:CLAVE@aws-0-us-east-1.pooler.supabase.com:6543/postgres
# La URL de Supabase va en las variables del proyecto en Vercel, y en la
# terminal solo para una corrida puntual con --produccion (ver README, "Tocar
# produccion desde la terminal"). En .env.local no: con ella, npm run dev,
# setup y seed escribirian en la base real.
#
# Con una base remota (cualquier host que no sea localhost, 127.0.0.1 o ::1)
# la conexion va SIEMPRE con TLS. Los parametros ssl de la URL (sslmode=...,
# ssl=..., sslrootcert=...) se ignoran: la politica la fija src/db/index.ts.
# Una base remota tambien vuelve obligatoria DNI_PEPPER y bloquea el login dev,
# aunque NODE_ENV no sea production.
# ---------------------------------------------------------------------------
DATABASE_URL=

# Certificado raiz de Supabase, para VERIFICAR la conexion TLS a la base. Sin
# esta variable la conexion va cifrada igual, pero sin comprobar el certificado
# (y lo avisa una vez en consola): protege de quien escucha, no de quien se hace
# pasar por la base.
#
# Las CA del sistema NO alcanzan: el pooler presenta *.pooler.supabase.com
# firmado por "Supabase Intermediate 2021 CA", que cuelga de "Supabase Root 2021
# CA", una raiz propia de Supabase. Se descarga del panel del proyecto:
# Project Settings > Database > SSL Configuration > Download certificate
# (prod-ca-2021.crt). Tambien viene en la propia conexion (es publico), como
# tercer bloque de:
#   openssl s_client -starttls postgres -connect aws-0-sa-east-1.pooler.supabase.com:6543 -showcerts </dev/null
# Antes de pegarlo, confirmar que es el correcto:
#   openssl x509 -in prod-ca-2021.crt -noout -subject -fingerprint -sha256
#   -> CN=Supabase Root 2021 CA
#   -> 80:70:25:AD:50:D4:ED:21:9D:2C:9C:7D:29:9C:00:4F:82:4E:B0:0C:F7:F6:5A:FE:F6:07:D0:7B:72:E6:CA:FA
# Se pega el CONTENIDO entero (no la ruta), con los saltos de linea escapados
# como \n si el valor va en una sola linea. Vence el 26/04/2031.
DATABASE_CA_PEM=

# ---------------------------------------------------------------------------
# Sesiones. Generar con:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Rotarlo cierra las sesiones abiertas y CAMBIA los codigos de seguimiento de
# ideas que ya tienen los vecinos (se derivan de este secreto, ver
# src/lib/avisos.ts). Al padron no lo toca: el DNI usa DNI_PEPPER.
# ---------------------------------------------------------------------------
SESSION_SECRET=cambiar-por-un-secreto-de-64-caracteres-hexadecimales-aleatorio

# ---------------------------------------------------------------------------
# Pimienta del hash del DNI del padron (src/lib/empadronamiento.ts).
# Obligatoria en produccion y con base remota, de 32 caracteres o mas; con base
# local, sin configurarla se usa una fija de desarrollo.
#
# NO SE ROTA NUNCA DURANTE UNA EDICION. Cambiarla equivale a vaciar el padron:
# la misma persona pasa a ser un votante nuevo y podria votar otra vez. Esta
# separada de SESSION_SECRET justamente para que rotar la sesion no la toque.
#
# PRIMERA VEZ CON PADRON EXISTENTE: hasta ahora el DNI se hasheaba con
# SESSION_SECRET. Poner aca EXACTAMENTE el valor que tiene hoy SESSION_SECRET en
# ese entorno: los hashes quedan iguales y el padron se conserva. Recien despues
# se puede rotar SESSION_SECRET. Con base nueva, generar un valor aleatorio como
# el de SESSION_SECRET.
#
# Si alguna vez algo corre contra Supabase fuera de Vercel (no deberia: el
# desarrollo usa PGlite), tiene que llevar la MISMA que produccion: con otra,
# cada ingreso crearia filas nuevas en el padron real.
# ---------------------------------------------------------------------------
DNI_PEPPER=

# Opcional. Pimienta del hash de la IP (limites de uso y votos repetidos). Sin
# ella se deriva de DNI_PEPPER con separacion de dominio, asi que tampoco
# cambia al rotar SESSION_SECRET. Existe para poder rotar la de la IP sin tocar
# la del DNI; en produccion, de 32 caracteres o mas (una mas corta se ignora).
# Al pasar a esta version los hashes de IP cambian una vez: los contadores de
# limite arrancan de cero y los ip_hash de antes no se cruzan con los nuevos.
IP_PEPPER=

# ---------------------------------------------------------------------------
# Modelo de lenguaje (OpenRouter). Lo usan el chat, el asistente de carga y el
# informe de impacto del panel. Sin esta clave nada rompe: el chat cae al
# buscador determinístico y las funciones de IA quedan desactivadas.
# ---------------------------------------------------------------------------
OPENROUTER_API_KEY=
# Identificador con la forma proveedor/modelo. Por defecto: anthropic/claude-sonnet-5
OPENROUTER_MODELO=
# Opcionales, si se quiere un modelo distinto por función:
# OPENROUTER_MODELO_CHAT=
# OPENROUTER_MODELO_ASISTENTE=
# OPENROUTER_MODELO_INFORME=
# Tope de mensajes por IP por hora en el endpoint del chat
CHAT_RATE_LIMIT=30
# Tope diario de tokens del modelo (entrada + salida) entre el chat, el
# asistente de carga y el informe de impacto, por dia calendario de Tucuman: el
# freno al gasto total, que el limite por IP no da. Pasado el tope el chat
# contesta con el buscador, el asistente no se ofrece y el informe no se genera
# (src/lib/modelo.ts). Es un tope blando: lo que esta en curso al cruzarlo suma.
#   vacio          -> sin tope (como hasta ahora)
#   2000000        -> dos millones; tambien acepta 2.000.000, pero NO 2,000,000
#   0 o invalido   -> la IA queda apagada sin sacar la clave (el invalido se
#                     avisa en el log)
CHAT_TOPE_TOKENS_DIA=

# ---------------------------------------------------------------------------
# Empadronamiento CIDITUC (la ciudadania digital del municipio).
#
# NO hay credenciales que pedir: no es OpenID Connect. No existen client_id ni
# client_secret. Lo unico que hay que gestionar con DITEC es que esta app quede
# registrada en el Derivador (repo `derivador`, no `cidituc`) con su clave y la
# URL de regreso https://<el sitio>/auth/cidituc/callback
#
# Con AUTH_PROVIDER=dev se usa un login de prueba local, sin verificar
# identidad: cualquiera escribe un DNI y un distrito. Solo funciona con base
# LOCAL (PGlite o Postgres en esta maquina) y fuera de produccion: con una
# DATABASE_URL remota el codigo lo bloquea aunque NODE_ENV sea development,
# porque escribiria DNIs inventados en el padron real. Sin AUTH_PROVIDER el
# valor por defecto es dev, asi que contra Supabase hay que poner cidituc.
# ---------------------------------------------------------------------------
AUTH_PROVIDER=dev

# Clave con la que la app quedo registrada en el Derivador (el `next=` de la
# URL de ingreso). Por defecto: presupuesto-participativo
CIDITUC_APP=

# El boton de ingreso aparece solo con "true". Se enciende DESPUES de que el
# Derivador tenga desplegada la entrada de esta app: antes, la persona se
# autentica bien y queda varada en la pantalla de ellos, sin mensaje.
CIDITUC_INGRESO_HABILITADO=false

# Solo en desarrollo: apunta el ingreso al Derivador que corre en tu maquina
# (el repo derivador, con npm run dev). Lleva SOLO el origen, sin el #/login. En
# produccion se ignora.
# CIDITUC_DERIVADOR=http://localhost:5173

# Cadena de certificados de Sectigo (intermedio + raiz) para hablar con
# estadisticas.smt.gob.ar:5000. Ese servidor manda la cadena completa o solo el
# certificado final segun por donde se llegue: desde Vercel llega sin el
# intermedio y Node corta con UNABLE_TO_VERIFY_LEAF_SIGNATURE. Se extrae de la
# propia conexion (son publicos) y se pega entero, con los saltos de linea
# escapados como \n si el valor va en una sola linea:
#   openssl s_client -connect estadisticas.smt.gob.ar:5000 -showcerts </dev/null
#   (guardar el 2do y 3er bloque BEGIN/END CERTIFICATE, concatenados)
# Sin esta variable la verificacion TLS sigue activa con el almacen por defecto:
# puede funcionar o no segun la red, pero NUNCA se desactiva.
CIDITUC_CA_PEM=

# URL publica del sitio. Es la base de la vuelta del callback (y de og:image y
# el sitemap). En Vercel se deduce sola; conviene fijarla igual.
SITE_URL=

# ---------------------------------------------------------------------------
# Usuario inicial del backoffice. Solo se usa al correr `npm run seed`, o sea en
# desarrollo. En produccion las cuentas se crean con `npm run crear-admin` (con
# --produccion) y las contrasenas las cambia cada persona desde /admin.
# ---------------------------------------------------------------------------
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NOMBRE=

# La edicion vigente y su etapa NO se configuran por entorno: se leen de la
# tabla `ediciones` (la fila con activa = true) y se cambian desde /admin.

# ---------------------------------------------------------------------------
# Solo para demostraciones. NUNCA en produccion.
#
# MODO_PRUEBA_IDEAS=1 abre el alta de ideas fuera de la etapa de presentacion
# para CUALQUIER visitante, sin sesion (src/lib/modo-prueba.ts). La ventana de
# presentacion la fija el reglamento: encendida en el sitio publico, se reciben
# ideas fuera de termino. Para mostrar el circuito no hace falta: con sesion del
# panel (/admin) se abre la misma puerta sin tocar el entorno.
# ---------------------------------------------------------------------------
MODO_PRUEBA_IDEAS=
