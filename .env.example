# ---------------------------------------------------------------------------
# Base de datos.
#   Vacio  -> PGlite embebido en ./data/pg: desarrollo local sin instalar nada.
#   Supabase -> pegar el "Connection string" del proyecto (Transaction pooler):
#   DATABASE_URL=postgres://postgres.xxxx:CLAVE@aws-0-us-east-1.pooler.supabase.com:6543/postgres
# En Vercel, configurar DATABASE_URL en las variables del proyecto.
# ---------------------------------------------------------------------------
DATABASE_URL=

# ---------------------------------------------------------------------------
# Sesiones. Generar con:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# ---------------------------------------------------------------------------
SESSION_SECRET=cambiar-por-un-secreto-de-64-caracteres-hexadecimales-aleatorio

# ---------------------------------------------------------------------------
# Modelo de lenguaje (OpenRouter). Lo usan el chat, el asistente de carga y el
# informe de impacto del panel. Sin esta clave nada rompe: el chat cae al
# buscador determinístico y las funciones de IA quedan desactivadas.
# ---------------------------------------------------------------------------
OPENROUTER_API_KEY=
# Identificador con la forma proveedor/modelo. Por defecto: anthropic/claude-sonnet-5
OPENROUTER_MODELO=
# Opcionales, si se quiere un modelo distinto por función:
# OPENROUTER_MODELO_CHAT=
# OPENROUTER_MODELO_ASISTENTE=
# OPENROUTER_MODELO_INFORME=
# Tope de mensajes por IP por hora en el endpoint del chat
CHAT_RATE_LIMIT=30

# ---------------------------------------------------------------------------
# Empadronamiento CIDITUC (la ciudadania digital del municipio).
#
# NO hay credenciales que pedir: no es OpenID Connect. No existen client_id ni
# client_secret. Lo unico que hay que gestionar con DITEC es que esta app quede
# registrada en el Derivador (repo `derivador`, no `cidituc`) con su clave y la
# URL de regreso https://<el sitio>/auth/cidituc/callback
#
# Con AUTH_PROVIDER=dev se usa un login de prueba local (NO usar en produccion).
# ---------------------------------------------------------------------------
AUTH_PROVIDER=dev

# Clave con la que la app quedo registrada en el Derivador (el `next=` de la
# URL de ingreso). Por defecto: presupuesto-participativo
CIDITUC_APP=

# El boton de ingreso aparece solo con "true". Se enciende DESPUES de que el
# Derivador tenga desplegada la entrada de esta app: antes, la persona se
# autentica bien y queda varada en la pantalla de ellos, sin mensaje.
CIDITUC_INGRESO_HABILITADO=false

# Solo en desarrollo: apunta el ingreso al Derivador que corre en tu maquina
# (el repo derivador, con npm run dev). Lleva SOLO el origen, sin el #/login. En
# produccion se ignora.
# CIDITUC_DERIVADOR=http://localhost:5173

# Cadena de certificados de Sectigo (intermedio + raiz) para hablar con
# estadisticas.smt.gob.ar:5000. Ese servidor manda la cadena completa o solo el
# certificado final segun por donde se llegue: desde Vercel llega sin el
# intermedio y Node corta con UNABLE_TO_VERIFY_LEAF_SIGNATURE. Se extrae de la
# propia conexion (son publicos) y se pega entero, con los saltos de linea
# escapados como \n si el valor va en una sola linea:
#   openssl s_client -connect estadisticas.smt.gob.ar:5000 -showcerts </dev/null
#   (guardar el 2do y 3er bloque BEGIN/END CERTIFICATE, concatenados)
# Sin esta variable la verificacion TLS sigue activa con el almacen por defecto:
# puede funcionar o no segun la red, pero NUNCA se desactiva.
CIDITUC_CA_PEM=

# URL publica del sitio. Es la base de la vuelta del callback (y de og:image y
# el sitemap). En Vercel se deduce sola; conviene fijarla igual.
SITE_URL=

# ---------------------------------------------------------------------------
# Usuario inicial del backoffice. Solo se usa al correr `npm run seed`.
# ---------------------------------------------------------------------------
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NOMBRE=

# La edicion vigente y su etapa NO se configuran por entorno: se leen de la
# tabla `ediciones` (la fila con activa = true) y se cambian desde /admin.
