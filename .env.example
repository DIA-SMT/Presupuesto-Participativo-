# ---------------------------------------------------------------------------
# Base de datos.
#   Vacio  -> PGlite embebido en ./data/pg: desarrollo local sin instalar nada.
#   Supabase -> pegar el "Connection string" del proyecto (Transaction pooler):
#   DATABASE_URL=postgres://postgres.xxxx:CLAVE@aws-0-us-east-1.pooler.supabase.com:6543/postgres
# En Vercel, configurar DATABASE_URL en las variables del proyecto.
# ---------------------------------------------------------------------------
DATABASE_URL=

# ---------------------------------------------------------------------------
# Sesiones. Generar con:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# ---------------------------------------------------------------------------
SESSION_SECRET=cambiar-por-un-secreto-de-64-caracteres-hexadecimales-aleatorio

# ---------------------------------------------------------------------------
# Chatbot (Claude). Sin esta clave el chat sigue funcionando en modo
# "buscador": responde con datos reales pero sin lenguaje natural.
# ---------------------------------------------------------------------------
ANTHROPIC_API_KEY=
CHAT_MODEL=claude-opus-5
CHAT_EFFORT=low
# Tope de mensajes por IP por hora en el endpoint del chat
CHAT_RATE_LIMIT=30

# ---------------------------------------------------------------------------
# Empadronamiento CIDITUC (OpenID Connect). Pedir credenciales al municipio.
# Con AUTH_PROVIDER=dev se usa un login de prueba local (NO usar en produccion).
# ---------------------------------------------------------------------------
AUTH_PROVIDER=dev
CIDITUC_ISSUER=
CIDITUC_CLIENT_ID=
CIDITUC_CLIENT_SECRET=
CIDITUC_REDIRECT_URI=http://localhost:3000/api/auth/callback

# ---------------------------------------------------------------------------
# Usuario inicial del backoffice. Solo se usa al correr `npm run seed`.
# ---------------------------------------------------------------------------
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NOMBRE=

# La edicion vigente y su etapa NO se configuran por entorno: se leen de la
# tabla `ediciones` (la fila con activa = true) y se cambian desde /admin.
