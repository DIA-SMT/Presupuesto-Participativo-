{
  "name": "pp-smt",
  "version": "1.0.0",
  "private": true,
  "description": "Presupuesto Participativo de San Miguel de Tucuman - sitio nuevo",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio",
    "etl": "tsx scripts/etl.ts",
    "seed": "tsx scripts/seed.ts",
    "setup": "npm run db:push && npm run etl && npm run seed",
